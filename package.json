{
  "name": "quiz-arena",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "check": "node scripts/check-questions.mjs && node scripts/check-oral.mjs",

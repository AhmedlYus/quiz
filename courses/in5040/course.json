{
  "appName": "Quiz",
  "code": "IN5040",
  "name": "Advanced Database Systems for Big Data",
  "tagline": "Practice for the oral exam: quiz yourself, then say it out loud",
  "lectures": [
    "Lecture 1: Introduction & Big Data Challenges",
    "Lecture 2: Data Stream Processing",
    "Lecture 3: Complex Event Processing, Esper & Operator Migration",
    "Lecture 4: Distributed Database Systems",
    "Lecture 5: Database Integration & Multi-DBS",
    "Lecture 6: Web Data Management",
    "Lecture 7: Data Analysis & Data Warehouses",
    "Lecture 8: Medical Data & Machine Learning",
    "Lecture 9: Scalable & Cloud Data Management",
    "Lecture 10: Large DBS & Performance Analysis"
  ],
  "sourceInfo": {
    "pages": "the slides for Lecture {lecture}",
    "pagesNoLecture": "the slides for this lecture",
    "books": [
      {
        "match": "özsu|ozsu|valduriez",
        "text": "Özsu & Valduriez: Principles of Distributed Database Systems, 4th ed. (2020)"
      },
      {
        "match": "elmasri|navathe",
        "text": "Elmasri & Navathe: Fundamentals of Database Systems, 5th ed. or newer"
      },
      {
        "match": "garcia|ullman|widom",
        "text": "Garcia-Molina, Ullman & Widom: Database Systems: The Complete Book, 2nd ed."
      },
      {
        "match": "hueske|kalavri|flink",
        "text": "Hueske & Kalavri: Stream Processing with Apache Flink (2019)"
      }
    ],
    "documents": [
      {
        "match": "assignment\\s*(\\d+)",
        "name": "Assignment $1",
        "doc": "the Assignment $1 description"
      }
    ]
  },
  "modes": {
    "quiz": true,
    "oral": true,
    "query": true
